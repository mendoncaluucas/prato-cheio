# Banco de dados (PostgreSQL). Copie este arquivo para .env.
# Nunca faça commit do .env: ele tem a senha do banco.

# Banco do grupo no Neon (ADR 0002): peça a connection string a um integrante.
# DATABASE_URL=postgres://usuario:senha@servidor/banco?sslmode=require

# Ou um PostgreSQL local descartável (o comando docker run está no README):
DATABASE_URL=postgres://pratocheio:pratocheio@localhost:5432/pratocheio

# Só para `npm test`, que apaga os dados do banco a cada execução. Aponte para um
# PostgreSQL descartável. NUNCA para o Neon. O npm test não lê o .env: defina a variável
# no terminal ao rodar, como mostra o README.
# DATABASE_URL_TESTE=postgres://pratocheio:pratocheio@localhost:5433/pratocheio
